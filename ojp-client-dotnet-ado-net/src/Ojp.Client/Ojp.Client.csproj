<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Api.CommonProtos" Version="2.17.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../ojp-grpc-commons/src/main/proto/StatementService.proto"
              ProtoRoot="../../../ojp-grpc-commons/src/main/proto"
              GrpcServices="Client"
              AdditionalImportDirs="$(NuGetPackageRoot)google.api.commonprotos/2.17.0/content/protos" />
  </ItemGroup>

</Project>
