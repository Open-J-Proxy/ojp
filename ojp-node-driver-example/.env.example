# Copy this file to `.env` and adjust the values for your setup.
# `.env` is gitignored — never commit real credentials.

# --- ojp-server ------------------------------------------------------------
# Address of the ojp-server instance that will proxy every call to the real
# database. See ../../ojp-server/README.md to run one locally.
OJP_HOST=localhost
OJP_PORT=1059

# --- Target database ---------------------------------------------------------
# DB_TYPE selects which TypeORM driver shim to use: "postgres" or "mssql".
DB_TYPE=postgres

# Values below match the local Docker containers documented in
# documents/environment-setup/run-local-databases.md.

# PostgreSQL (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defaultdb
DB_USER=testuser
DB_PASSWORD=testpassword

# SQL Server (used when DB_TYPE=mssql) — uncomment/adjust and set DB_TYPE=mssql
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=master
# DB_USER=sa
# DB_PASSWORD=TestPassword123!
